<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.lol</groupId>
    <artifactId>lol-server</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>lol-server</name>
    <description>LOL 战绩查询与交友 - 服务端</description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <!-- Web MVC -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lol</groupId>
            <artifactId>lol-common</artifactId>
            <version>1.0.0</version>
        </dependency>
        <!-- 本地 LCU 读取逻辑，供"录入战绩"直接连客户端读取 -->
        <dependency>
            <groupId>com.lol</groupId>
            <artifactId>lol-lcu-reader</artifactId>
            <version>1.0.0</version>
        </dependency>
        <!-- WebSocket：房间实时聊天用的长连接 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <!-- JPA 数据访问 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!-- MySQL 驱动 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Redis：把「谁在线」「用户资料」「队伍成员」这类反复读的热点搬到内存里，
             数据库只负责持久化和写操作。
             版本显式锁 3.2.4 —— 本地离线仓库里没有跟 Boot 版本对齐的 3.2.5，
             3.2.4 与 3.2.x 的 Boot 完全兼容。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
            <version>3.2.4</version>
        </dependency>
        <!-- 密码 BCrypt 加密（只引入 crypto，不引入整套 Security） -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
